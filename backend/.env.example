# Copy this file to .env and fill in real values:
#   cp .env.example .env

# Port the Express server (and WebSocket hub) listens on.
PORT=3000

# development | production — controls the [DEBUG-REQ] request logger in
# server.js (only logs when NOT "production").
NODE_ENV=development

# Set to 1 only when the backend is behind a trusted reverse proxy that
# overwrites X-Forwarded-For. Leave 0 when clients can reach Node directly.
TRUST_PROXY=0

# Comma-separated list of API keys the in-game mod can authenticate with
# for POST /api/prices (see services/auth.js). Must match `apiKey` in the
# mod's config.json. Example: API_KEYS=some-long-random-string
API_KEYS=

# Allowed origin for browser CORS requests from the Next.js frontend.
# Use the exact frontend origin in production (e.g. https://wmarket.example.com) —
# "*" is only safe for local development.
CORS_ORIGIN=http://localhost:3000

# --- Firebase credentials — pick ONE of the two options below ---
# See database/firestore.js for full details on each option.

# Option 1: paste the ENTIRE downloaded service account key JSON as one line.
# Best for hosts where mounting a file is inconvenient (Render/Railway/etc).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 2: path to the downloaded service account key JSON file.
# Best for local development (or `gcloud auth application-default login`
# with this var unset, using Application Default Credentials instead).
GOOGLE_APPLICATION_CREDENTIALS=

rules_version = '2';

// This project's architecture is: Game/mod API -> Express Backend ->
// Firestore -> Next.js Frontend. The frontend NEVER talks to Firestore
// directly — only the Express backend does, using the Firebase Admin SDK
// (a privileged service-account connection that bypasses these rules
// entirely). These rules exist purely as a safety net: if anyone ever adds
// a Firebase client SDK to the frontend later (bypassing the backend), this
// denies all access by default instead of leaving the database wide open.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
